#!/bin/bash

set -o errexit -o nounset -o pipefail

cd /etc/nginx

mode="$1"

[[ $mode == @(daily|hourly) ]] || exit 1

if [[ $mode == daily ]]; then
    curl -sS --fail-with-body https://www.stopforumspam.com/downloads/toxic_ip_cidr.txt > stopforumspam-toxic_ip_cidr.txt.new
    mv stopforumspam-toxic_ip_cidr.txt.new stopforumspam-toxic_ip_cidr.txt

    curl -sS --fail-with-body https://www.stopforumspam.com/downloads/listed_ip_30.zip | gunzip > stopforumspam-listed_ip_30.txt.new
    mv stopforumspam-listed_ip_30.txt.new stopforumspam-listed_ip_30.txt
fi

if [[ $mode == hourly ]]; then
    curl -sS --fail-with-body https://www.stopforumspam.com/downloads/listed_ip_1.zip | gunzip > stopforumspam-listed_ip_1.txt.new
    mv stopforumspam-listed_ip_1.txt.new stopforumspam-listed_ip_1.txt

    if curl -sS --fail-with-body https://check.torproject.org/torbulkexitlist | sort -u > torbulkexitlist.txt.new; then
        mv torbulkexitlist.txt.new torbulkexitlist.txt
    fi

    sort -u registration-ip-blocklist-local.txt stopforumspam-toxic_ip_cidr.txt stopforumspam-listed_ip_30.txt stopforumspam-listed_ip_1.txt | comm -1 -3 torbulkexitlist.txt - | awk '{ print $1 " 1;" }' > registration-ip-blocklist.conf.new
    mv registration-ip-blocklist.conf.new registration-ip-blocklist.conf
fi
