#!/bin/bash

set -o errexit -o nounset -o pipefail
shopt -s inherit_errexit

cd /opt
su -s /usr/bin/bash flarum -c "find flarum/public/assets/ \( -name '*.gz' -o -name '*.br' \) -delete"
su -s /usr/bin/bash flarum -c "rsync -tv --fsync --preallocate flarum-staging/composer.{lock,json} flarum/"
systemctl stop php-fpm
su -s /usr/bin/bash flarum -c "rsync -tvr --delete --fsync --preallocate flarum-staging/vendor/ flarum/vendor"
su -s /usr/bin/bash flarum -c "cd flarum && php flarum migrate && php flarum cache:clear && php flarum assets:publish"
systemctl start php-fpm
su -s /usr/bin/bash flarum -c 'rsync -tv flarum/disposable-email-domains.txt flarum/vendor/fgribreau/mailchecker/list.txt'
su -s /usr/bin/bash flarum -c 'cd flarum/vendor/fgribreau/mailchecker && npm install && npm run build'
systemctl restart php-fpm
su -s /usr/bin/bash flarum -c flarum-asset-compress
